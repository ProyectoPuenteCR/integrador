<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Documento por defecto: servir index.php al entrar a la carpeta -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Sin listado de directorios -->
    <directoryBrowse enabled="false" />

    <!-- Permitir que esta carpeta ejecute scripts (PHP via FastCGI).
         Equivale a marcar "Execute" en Feature Permissions. -->
    <handlers accessPolicy="Read, Execute, Script" />

  </system.webServer>
</configuration>
